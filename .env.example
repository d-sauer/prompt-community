# .env.example — copy to .env and fill in values
# Do NOT commit .env to version control

# GitHub organization or user owning the data repo
VITE_GITHUB_OWNER=your-org

# Data repo name (the GitHub Issues store)
VITE_GITHUB_REPO=prompt-community-data

# GitHub OAuth App client ID
VITE_GITHUB_CLIENT_ID=Iv1.xxxxxxxxxx

# Cloudflare Worker base URL (OAuth + image proxy)
VITE_CF_WORKER_URL=https://auth.your-domain.workers.dev

# Cloudflare R2 public URL for image storage
VITE_R2_PUBLIC_URL=https://assets.your-domain.com

# GitHub App installation ID for anonymous read token
VITE_GITHUB_APP_INSTALLATION_ID=12345678
